# Office network (http://192.168.245.25:3003). Copy to ../.env and fill in.
# Plain HTTP, so secure cookies / SSL redirect stay off; DEBUG is still off.
DJANGO_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=192.168.245.25,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://192.168.245.25:3003
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_PROXY_SSL_HEADER=
APP_PORT=3003

POSTGRES_DB=hapl
POSTGRES_USER=hapl
POSTGRES_PASSWORD=change-me

DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
