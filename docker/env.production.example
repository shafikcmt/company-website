# Public site behind Cloudflare Tunnel (https://humanaapparels.com).
# The tunnel talks plain HTTP to the container, so the proxy header is required.
DJANGO_ENV=production
DEBUG=false
# 50+ characters: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=humanaapparels.com,www.humanaapparels.com,192.168.245.25,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://humanaapparels.com,https://www.humanaapparels.com
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_HSTS_SECONDS=0
APP_PORT=3003

# Cloudflare Zero Trust → Networks → Tunnels → (tunnel) → token.
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

POSTGRES_DB=hapl
POSTGRES_USER=hapl
POSTGRES_PASSWORD=

DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
