# Development only; never put production secrets in this example.
DJANGO_ENV=development
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Empty development key generates a temporary key; set a local key for stable sessions.
SECRET_KEY=
# Omit DATABASE_URL to use local db.sqlite3. Tests use sqlite:///:memory:.
# DATABASE_URL=sqlite:///db.sqlite3
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_PROXY_SSL_HEADER=
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Email Configuration
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
