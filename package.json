{
    "name": "po-evidence",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "tailwind:admin": "npx tailwindcss -i common/static/css/admin.tailwind.css -o common/static/css/admin.styles.css --minify --watch --config tailwind.admin.config.js",
        "tailwind:public": "npx tailwindcss -i common/static/css/public.tailwind.css -o common/static/css/public.styles.css --minify --watch --config tailwind.public.config.js",
        "dev": "concurrently \"npm run tailwind:admin\" \"npm run tailwind:public\"",
        "build:public": "tailwindcss -i common/static/css/public.tailwind.css -o common/static/css/public.styles.css --minify --config tailwind.public.config.js",
        "build:admin": "tailwindcss -i common/static/css/admin.tailwind.css -o common/static/css/admin.styles.css --minify --config tailwind.admin.config.js",
        "build": "npm run build:public && npm run build:admin"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.16",
        "concurrently": "^9.1.2",
        "tailwindcss": "^3.4.17"
    },
    "dependencies": {
        "preline": "^2.7.0",
        "taos": "^1.0.5"
    }
}
